#!/usr/bin/env bash
# Pre-commit guard: run the collection check against the index — including
# newly staged files — so identity/structure problems fail the commit, not CI.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/sync/check.sh" --collection-only
